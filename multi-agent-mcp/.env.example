# =============================================================================
# Security — read before copying to .env
# - Copy this file: cp .env.example .env  then edit .env with real values.
# - Never commit .env (gitignored). Restrict file permissions: chmod 600 .env
# - Docker images do not include .env; pass secrets at runtime (--env-file,
#   docker-compose env_file, or your orchestrator’s secrets manager).
# - Prebuilt image + one command: see docker-compose.prod.yml and DOCKER_DEPLOYMENT.md
#   (Opción C: tar + .env file beside compose, no rebuild).
# - Encryption (SOPS, age, etc.) only helps if the decryption key is not shipped with the
#   same bundle as the image; see DOCKER_DEPLOYMENT.md “¿Y si encriptamos las contraseñas?”.
# - On AWS, prefer AWS Secrets Manager or SSM Parameter Store + IAM; inject env at deploy
#   (ECS/EKS/Lambda); see DOCKER_DEPLOYMENT.md “AWS: vault nativo vs HashiCorp Vault”.
# =============================================================================

# --- Optional: one JSON secret in AWS Secrets Manager (app loads at startup; see DOCKER_DEPLOYMENT.md) ---
# AWS_SECRETS_MANAGER_SECRET_ID=oneview/goc/prod
# AWS_SECRETS_MANAGER_REGION=us-east-1
# AWS_SECRETS_MANAGER_OVERWRITE=0
# AWS_SECRETS_MANAGER_REQUIRED=0

# Atlassian/Confluence Credentials
ATLASSIAN_EMAIL=your_email@arlo.com
CONFLUENCE_TOKEN=your_confluence_token_here
# Next Deployments sidebar: Confluence Team Calendar API (same GRM as wiki RM / GRM Calendar).
# If no events are returned, the widget stays empty. Set to 1 only for local UI demos (synthetic rows):
# DEPLOYMENTS_USE_MOCK_DATA=0
# Sub-calendar ID: must be the Team Calendars *subCalendarId* (not always equal to the page id). List: GET
# .../wiki/rest/calendar-services/1.0/calendar/subcalendars.json — default matches GRM page 153256867 when linked.
# DEPLOYMENTS_SUBCALENDAR_ID=153256867
# How far ahead to *request* from the Calendar API (calendar days, CST window):
# DEPLOYMENTS_CALENDAR_FETCH_DAYS_AHEAD=60
# How many *past* calendar days to include in the request (all-day / boundary events):
# DEPLOYMENTS_CALENDAR_LOOKBACK_DAYS=2
# UI filter: show events overlapping [now - h, now + h]. Default 720 = 30d ahead (2h back):
# DEPLOYMENTS_FILTER_HOURS_FUTURE=720
# DEPLOYMENTS_FILTER_HOURS_PAST=2
# Max rows returned to the client (default 50):
# DEPLOYMENTS_MAX_ROWS=50
# Bedrock/MCP tool calls localhost /api/deployments/upcoming; Confluence can exceed 10s (default read 90s):
# DEPLOYMENTS_INTERNAL_HTTP_CONNECT_TIMEOUT=5
# DEPLOYMENTS_INTERNAL_HTTP_READ_TIMEOUT=90

# Google Gemini API (Legacy)
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Bedrock API Key (starts with ABSK - from AWS Bedrock console)
BEDROCK_API_KEY=ABSKxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Datadog Credentials (keys: https://arlo.datadoghq.com/organization-settings/api-keys)
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
# Site key for API (US1); UI links use https://arlo.datadoghq.com via datadog_ui_origin()
DATADOG_SITE=datadoghq.com

# Status monitor (/statusmonitor/...) — same service lists as APM wall (lists/*.txt) by default
# STATUS_MONITOR_USE_BUNDLED_LISTS=1
#
# Optional: "Open in Datadog" for /apm-services (APM Status Wall; link to org Software / APM UI)
# DATADOG_APM_SOFTWARE_BASE=https://arlo.datadoghq.com/software?env=production&fromUser=true

# APM Status Wall (/apm-services) — APM `env` tag: production, goldendev, goldenqa, adt_prod, qa, or samsung_prod
# APM_STATUS_WALL_DD_ENV=production
# Bundled: production_apm_127, *goldendev*, *goldenqa*, adt/qa/samsung _apm_services.txt
# SOFTWARE_CATALOG_USE_BUNDLED_GOLDENDEV=0
# SOFTWARE_CATALOG_USE_BUNDLED_GOLDENQA=0
# SOFTWARE_CATALOG_USE_BUNDLED_ADT=0
# SOFTWARE_CATALOG_USE_BUNDLED_QA=0
# SOFTWARE_CATALOG_USE_BUNDLED_SAMSUNG=0
# Tag APM Samsung (mismo que hub; default samsung_prod):
# SAMSUNG_DD_ENV=samsung_prod
# APM wall: EKS cluster lookup on by default (needed for correct Oregon / Ireland tile split). Off = faster, wrong regions.
# APM_STATUS_WALL_ATTACH_EKS=1
# Header "light" reuses one PagerDuty pull (no Splunk + no extra PD board calls):
# APM_STATUS_WALL_HEADER_LIGHT=1
# APM wall in-memory cache bucket (seconds; 300 = refetch at most every ~5 min for same range)
# APM_STATUS_WALL_CACHE_SECS=300
# For production: bundled lists/production_apm_127.txt. Override or disable:
# SOFTWARE_CATALOG_SERVICE_NAMES=svc1,svc2
# SOFTWARE_CATALOG_SERVICE_LIST_FILE=/path/to/one-service-per-line.txt
# SOFTWARE_CATALOG_USE_BUNDLED_127=1
# Set to 1 to list services from GET /api/v2/catalog/entity (needs catalog read on the app key)
# SOFTWARE_CATALOG_USE_API=0
# SOFTWARE_CATALOG_MAX_ENTITIES=150
# If using API, narrow to the same ~90 service names the monitor already knows (recommended)
# SOFTWARE_CATALOG_API_INTERSECT_FALLBACK=1
# Status Monitor Samsung: APM env tag for queries (default samsung_prod). Override only if your DD tag differs.
# SAMSUNG_DD_ENV=samsung_prod
#
# Status Monitor — reduce CPU / Datadog burst (optional; defaults are conservative)
# STATUS_MONITOR_CACHE_SECS=180          # dashboard + hub in-memory HTML/summary TTL (60–900)
# STATUS_MONITOR_DB_CACHE_SECS=180       # SQLite API cache: per-service Datadog health + PagerDuty + Arlo (30–900; same key = skip live API)
# STATUS_MONITOR_FORCE_REFRESH_GRACE_SECS=30   # manual Refresh: skip DB/mem reuse only if cached < this many seconds ago (5–300)
# STATUS_MONITOR_UNKNOWN_RETRIES=2       # extra live Datadog health attempts when result is still unknown (0–5)
# STATUS_MONITOR_DD_MAX_WORKERS=10       # max parallel service health tasks per page load
# STATUS_MONITOR_DD_MIN_WORKERS=3
# STATUS_MONITOR_HUB_PARALLEL_ENVS=4   # hub: parallel jobs (default 4: batch main-3 + samsung + adt + red-us). Lower if DD rate-limits.
# STATUS_MONITOR_EKS_MAX_WORKERS=6       # parallel EKS cluster lookups for non-healthy services
# STATUS_MONITOR_DD_MONITOR_ERROR_OVERRIDE=1   # 1=if error-rate is warn/crit but ALL matching DD monitors (service+env tags) are OK/No Data/etc., show healthy
# STATUS_MONITOR_DD_MONITOR_ALERTS=1           # 1=escalate tiles from DD monitor search when overall_state=Alert (1→warning/yellow, 2+→critical/red); show names in hover; 0=APM only
# STATUS_MONITOR_DD_MONITOR_CACHE_SECS=120      # cache TTL for monitor search (30–600)

# ServiceNow Credentials (if needed)
SNOW_USER=your_servicenow_user
SNOW_PASSWORD=your_servicenow_password

# Optional: Arlo-specific credentials (if different from Atlassian)
# ARLO_USER=your_arlo_user
# ARLO_PASSWORD=your_arlo_password

# Splunk Credentials
SPLUNK_HOST=arlo.splunkcloud.com
SPLUNK_TOKEN=your_splunk_token_here
# SPLUNK_SEARCH_TIMEZONE=America/Los_Angeles   # REST earliest/latest + predict (default PST)
# SPLUNK_DISPLAY_TIMEZONE=America/Los_Angeles  # chart labels (defaults to search TZ if unset)

# Slack Bot Token (for Ask_ARLOCHAT integration)
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Slack Incoming Webhook — 📤 Slack: Bedrock summarizes visible page text (English + Block Kit) and posts here
# Requires BEDROCK_API_KEY. Optional: SLACK_SUMMARY_INPUT_MAX_CHARS=100000
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
#
# If you see SSL errors (e.g. UNEXPECTED_EOF_WHILE_READING) to hooks.slack.com:
# - Corporate proxy: set REQUESTS_CA_BUNDLE=/path/to/your-org-ca.pem (or install the root CA).
# - Retries: optional SLACK_WEBHOOK_REQUEST_ATTEMPTS=3 (default 3, max 8).
# - Last resort only (insecure): SLACK_SSL_VERIFY=0
#
# Screenshots: Slack fetches the PNG from your app; in production set a public HTTPS URL:
# PUBLIC_BASE_URL=https://your-server.oneview.example.com
# (Otherwise request.url_root is used; localhost cannot be embedded by Slack as image_url.)

# Optional: direct upload via Bot API (xoxb- token, not xapp-)
# SLACK_CHANNEL_ID=C01234567890

# PagerDuty API Token
PAGERDUTY_API_TOKEN=your_pagerduty_api_token_here
# Home index + Status Monitor + Status Wall: /api/pagerduty/monitor is all-account incidents (no external board filter).
# Samsung widget + /api/pagerduty/samsung-monitor: external status board scope (REST status_dashboard_ids[]).
# Default PRBJIO4 — https://arlo.pagerduty.com/external-status-dashboard/PRBJIO4/incidents
# SAMSUNG_STATUS_DASHBOARD_ID=PRBJIO4
# ADT status widget + /api/pagerduty/adt-monitor — default PK1QF1G
# https://arlo.pagerduty.com/external-status-dashboard/PK1QF1G/incidents
# ADT_STATUS_DASHBOARD_ID=PK1QF1G
# Disable external-board widgets: off | false | no | 0 | none | *
# PAGERDUTY_SUBDOMAIN=arlo
