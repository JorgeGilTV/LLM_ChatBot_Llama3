{
  "manifest_version": 3,
  "name": "GocView Chatbot",
  "version": "2.4.0",
  "description": "GocView Chatbot — ask from any page; ServiceNow session sync for ServiceDesk dashboard.",
  "permissions": ["storage", "activeTab", "cookies", "scripting", "tabs"],
  "host_permissions": [
    "https://gocview.arlocloud.com/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "https://*.service-now.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GocView Chatbot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/arlo-logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gocview.arlocloud.com/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:8080/*"
      ],
      "js": ["snow-connect-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.service-now.com/*"],
      "js": ["snow-sn-relay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "css": ["brand.css", "content.css"],
      "run_at": "document_idle"
    }
  ]
}
