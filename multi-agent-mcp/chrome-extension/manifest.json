{
  "manifest_version": 3,
  "name": "GocView Chatbot",
  "version": "2.2.0",
  "description": "GocView Chatbot — ask from any page; answers are summarized and sent to Slack.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://gocview.arlocloud.com/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GocView Chatbot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/arlo-logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "css": ["brand.css", "content.css"],
      "run_at": "document_idle"
    }
  ]
}
